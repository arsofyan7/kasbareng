# ==============================================================================
# KASBARENG ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=kasbareng_db

# Prisma Database URL
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5432/kasbareng_db?schema=public"

# Security & Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=7d

# Hash Chain Salt / Config (Internal)
AUDIT_CHAIN_SALT=your_audit_salt
